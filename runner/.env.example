# Copy to runner/.env on the box and fill in. Never commit .env.
# A long-lived Claude Code token for your subscription: run `claude setup-token` on your Mac and paste it here.
CLAUDE_CODE_OAUTH_TOKEN=
# A GitHub token that can push branches, open and merge pull requests on the repositories the runner builds.
GH_TOKEN=
GIT_AUTHOR_NAME=Kompass runner
GIT_AUTHOR_EMAIL=kompass-runner@users.noreply.github.com
# Optional phone notifications (runner/notify.sh): an ntfy topic nobody can guess, e.g. from `openssl rand -hex 10`.
NOTIFY_URL=https://ntfy.sh/kompass-<random>
